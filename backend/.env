# Backend service configuration.
#
# Generate a fresh IAM database token before starting the API:
# aws rds generate-db-auth-token --hostname my-db-cluster.cluster-c4j042eqkxdd.us-east-1.rds.amazonaws.com --port 5432 --username postgres --region us-east-1

DATABASE_URL=postgres://postgres:REPLACE_WITH_IAM_TOKEN@my-db-cluster.cluster-c4j042eqkxdd.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
S3_MEDIA_BUCKET=framemio-media
SQS_PROCESSING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/450876624497/framemio-processing
AUTH_HMAC_SECRET=replace-with-at-least-32-characters
INTERNAL_API_TOKEN=replace-with-at-least-32-characters
AWS_REGION=us-east-1
PORT=8080
