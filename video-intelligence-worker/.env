# Video intelligence worker configuration.
#
# Generate a fresh IAM database token before starting the worker:
# aws rds generate-db-auth-token --hostname my-db-cluster.cluster-c4j042eqkxdd.us-east-1.rds.amazonaws.com --port 5432 --username postgres --region us-east-1

DATABASE_URL=postgres://postgres:REPLACE_WITH_IAM_TOKEN@my-db-cluster.cluster-c4j042eqkxdd.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
S3_MEDIA_BUCKET=framemio-media
SQS_VIDEO_ANALYSIS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/450876624497/framemio-video-analysis
AWS_REGION=us-east-1

VIDEO_UNDERSTANDING_API_URL=http://localhost:9000
VIDEO_UNDERSTANDING_API_KEY=replace-with-api-key
VIDEO_UNDERSTANDING_PROVIDER=external
VIDEO_UNDERSTANDING_MODEL=configured-model
TRANSCRIPTION_API_URL=http://localhost:9001
TRANSCRIPTION_API_KEY=replace-with-api-key
TRANSCRIPTION_PROVIDER=external
TRANSCRIPTION_MODEL=configured-model
ENABLE_TRANSCRIPTION=true
