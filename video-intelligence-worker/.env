# Video intelligence worker configuration.
#
# Generate a fresh IAM database token before starting the worker:
# aws rds generate-db-auth-token --hostname framemio.c4j042eqkxdd.us-east-1.rds.amazonaws.com --port 5432 --username framemio_app --region us-east-1
#
# Direct video understanding uses VIDEO_UNDERSTANDING_UPSTREAM_BASE_URL.
# Adapter mode uses VIDEO_UNDERSTANDING_API_URL. API keys stay server-side.

DATABASE_URL=postgres://framemio_app@framemio.c4j042eqkxdd.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
S3_MEDIA_BUCKET=framemio-media
SQS_VIDEO_ANALYSIS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/450876624497/framemio-processing
AWS_REGION=us-east-1
DATABASE_AUTH_MODE=iam

VIDEO_UNDERSTANDING_DIRECT=true
VIDEO_UNDERSTANDING_UPSTREAM_BASE_URL=https://api2.65535.space
VIDEO_UNDERSTANDING_WIRE_API=chat_completions
VIDEO_UNDERSTANDING_API_KEY=replace-with-api-key
VIDEO_UNDERSTANDING_PROVIDER=openai-direct
VIDEO_UNDERSTANDING_MODEL=gpt-5.4-mini
VIDEO_UNDERSTANDING_VERSION=video-understanding-v1
VIDEO_UNDERSTANDING_RETRIES=3
VIDEO_UNDERSTANDING_PROVIDER_TIMEOUT=2m
VIDEO_UNDERSTANDING_IMAGE_DETAIL=low
VIDEO_UNDERSTANDING_MAX_OUTPUT_TOKENS=5000

ENABLE_TRANSCRIPTION=true
TRANSCRIPTION_API_URL=http://localhost:9001
TRANSCRIPTION_API_KEY=replace-with-api-key
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-5.4-mini-transcribe
TRANSCRIPTION_VERSION=transcription-v1
TRANSCRIPTION_RETRIES=3
TRANSCRIPTION_PROVIDER_TIMEOUT=90s
TRANSCRIPTION_RAW_ARTIFACT_THRESHOLD_BYTES=262144

BACKEND_INTERNAL_API_URL=https://api.framemio.com
INTERNAL_API_TOKEN=replace-with-at-least-32-characters
